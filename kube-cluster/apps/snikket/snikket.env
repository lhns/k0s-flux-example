# Snikket configuration, shared by all three containers (envFrom configMapRef).
# Upstream ships this as snikket.conf consumed via docker-compose `env_file`;
# same keys, same semantics.
#
# SNIKKET_DOMAIN IS PERMANENT. It is the JID domain (user@xmpp.example.com), it is
# baked into prosody's data store on first boot, and Snikket has no rename path.
SNIKKET_DOMAIN=xmpp.example.com
SNIKKET_ADMIN_EMAIL=admin+snikket@example.com
SNIKKET_SITE_NAME=lhns Chat

# The web listeners stay on their defaults, 80 and 443.
#
# Upstream's reverse-proxy guide says to move them (5080/5443), but that guide
# assumes network_mode: host, where they would collide with the front proxy. In
# a Pod there is no collision — and moving them is actively wrong here, because
# Snikket builds its PUBLIC urls from these values: with HTTPS_PORT=5443 every
# redirect pointed at https://xmpp.example.com:5443/, which is not reachable.
#
# Traefik therefore speaks HTTPS to the backend on 443 (routing.yaml, via a
# ServersTransport) rather than plain HTTP. That also avoids the redirect loop
# the HTTP path would cause: Snikket would 301 to https://xmpp.example.com/, traefik
# would forward it back as HTTP, and round it goes.

# Use the shared coturn (apps/coturn) instead of the bundled one, so there is a
# single UDP relay range to forward on the router rather than one per app.
# The secret is injected separately from the reflected Secret, not set here.
SNIKKET_TWEAK_TURNSERVER=0
SNIKKET_TWEAK_TURNSERVER_DOMAIN=turn.example.com
SNIKKET_TWEAK_TURNSERVER_PORT=3478

# The cluster is IPv4-only, but pods keep a link-local IPv6 — which makes glibc
# hand out unreachable AAAA records and breaks anything that doesn't fall back.
# Same reason apps/uptime-kuma needed the disable_ipv6 sysctl (see k0sctl.yaml).
SNIKKET_TWEAK_IPV6=0

# Uploads are capped well below the 20Gi PVC so file sharing cannot fill the
# volume out from under prosody's own state.
SNIKKET_UPLOAD_STORAGE_GB=10
SNIKKET_DAILY_UPLOAD_LIMIT_PER_USER_GB=1

# Certificates come from cert-manager, not certbot, and are re-read on this
# interval — so renewal needs no restart and no certs container.
SNIKKET_TWEAK_WEB_PROXY_RELOAD_INTERVAL=3600

SNIKKET_LOGLEVEL=info
# Anonymous update-check beacon over DNS; off, like every other phone-home here.
SNIKKET_UPDATE_CHECK=0

# Load the LDAP authentication config. Replaces the default glob
# (/snikket/prosody/*.cfg.lua, i.e. on the PVC) with a ConfigMap-backed path, so
# the config is in git and reviewable rather than hand-placed on a volume.
SNIKKET_TWEAK_EXTRA_CONFIG=/etc/snikket-extra/*.cfg.lua
