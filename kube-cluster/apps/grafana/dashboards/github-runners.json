{
  "uid": "github-runners",
  "title": "GitHub Runners",
  "tags": [
    "ci",
    "github"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Provisioned from git (kube-cluster/apps/grafana/dashboards). Needs the VictoriaMetrics datasource: MetricsQL, dotted metric names.",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "scale_set",
        "label": "Scale set",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(gha_desired_runners, actions_github_com_scale_set_name)",
          "refId": "q"
        },
        "definition": "label_values(gha_desired_runners, actions_github_com_scale_set_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Runners and jobs",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Runners by state",
      "description": "Dashed lines are the scale set's configured min and max.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": " (min|max)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_desired_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} desired",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_registered_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} registered",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_busy_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} busy",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_idle_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} idle",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_min_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} min",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_max_runners{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} max",
          "refId": "F"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Assigned and running jobs",
      "description": "Assigned minus running is the backlog waiting for a runner.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_assigned_jobs{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} assigned",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (actions_github_com_scale_set_name) (gha_running_jobs{actions_github_com_scale_set_name=~\"$scale_set\"})",
          "legendFormat": "{{actions_github_com_scale_set_name}} running",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs started and completed per hour",
      "description": "Counters reset when a listener restarts; rate() handles that.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum(rate(gha_started_jobs_total{actions_github_com_scale_set_name=~\"$scale_set\"}[$__rate_interval])) * 3600",
          "legendFormat": "started",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (job_result) (rate(gha_completed_jobs_total{actions_github_com_scale_set_name=~\"$scale_set\"}[$__rate_interval])) * 3600",
          "legendFormat": "completed {{job_result}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Jobs in range by result",
      "description": "Completed jobs in the selected time range.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (job_result) (increase(gha_completed_jobs_total{actions_github_com_scale_set_name=~\"$scale_set\"}[$__range]))",
          "legendFormat": "{{job_result}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Wait for a runner",
      "description": "From the job being queued to it starting on a runner.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gha_job_startup_duration_seconds_bucket{actions_github_com_scale_set_name=~\"$scale_set\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gha_job_startup_duration_seconds_bucket{actions_github_com_scale_set_name=~\"$scale_set\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Job duration by job",
      "description": "Over the selected time range.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, job_name) (increase(gha_job_execution_duration_seconds_bucket{actions_github_com_scale_set_name=~\"$scale_set\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job_name) (increase(gha_job_execution_duration_seconds_bucket{actions_github_com_scale_set_name=~\"$scale_set\"}[$__range])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Resources (runner pods)",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU per scale set",
      "description": "CPU cores, summed over the scale set's runner pods.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": " request$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (scale_set) (label_replace(k8s.pod.cpu.usage{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{scale_set}} used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (scale_set) (label_replace(k8s.container.cpu_request{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{scale_set}} request",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory per scale set",
      "description": "Summed over the scale set's runner pods.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": " (request|limit)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (scale_set) (label_replace(k8s.pod.memory.working_set{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{scale_set}} working set",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (scale_set) (label_replace(k8s.container.memory_request{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{scale_set}} request",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (scale_set) (label_replace(k8s.container.memory_limit{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{scale_set}} limit",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Worst pod memory vs limit",
      "description": "Highest working set / limit among the scale set's pods. Near 100% means an OOM kill.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (scale_set) (label_replace(k8s.pod.memory.working_set{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"} / on(\"k8s.pod.name\") k8s.container.memory_limit{\"k8s.namespace.name\"=\"github-runner\",\"k8s.container.name\"=\"runner\",\"k8s.pod.name\"=~\"($scale_set)-runner-.+\"}, \"scale_set\", \"$1\", \"k8s.pod.name\", \"(.+)-runner-[a-z0-9]+\"))",
