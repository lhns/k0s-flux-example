# Auth-injecting reverse proxy in front of KasmVNC, so Authelia is the only login.
#
# KasmVNC cannot be run without its own HTTP Basic auth: `-DisableBasicAuth` covers the
# websocket only, and every /api/* call still answers 401 — which is what makes the browser
# put up a second password box. There is no config option for it.
#
# Traefik cannot inject the credential itself, because `customRequestHeaders` values are
# literals in the Middleware object and cannot be sourced from a Secret — that would mean a
# credential in plaintext in git. So the header is added here instead, where VNC_PW arrives
# from the SOPS-encrypted Secret as an env var and __AUTH__ is substituted at startup.
#
# Also lets Traefik speak plain HTTP to the pod, which removes the ServersTransport with
# insecureSkipVerify that used to be needed for KasmVNC's self-signed certificate.

events {
  worker_connections 1024;
}

http {
  # Required for the websocket upgrade to be forwarded rather than swallowed.
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  access_log off;
  error_log  /dev/stderr warn;

  server {
    listen 8080;

    # The desktop streams; none of this should be buffered or time out mid-session.
    proxy_buffering    off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
      # KasmVNC serves HTTPS only, with a certificate generated at image build time that
      # cannot be replaced without rebuilding. Verification is off for the same reason it
      # was on the old ServersTransport, except the hop is now inside a single pod over
      # loopback rather than across the cluster network.
      proxy_pass              https://127.0.0.1:6901;
      proxy_ssl_verify        off;
      proxy_ssl_server_name   on;

      # The whole point: the browser never sees a 401, so it never prompts.
      proxy_set_header Authorization "Basic __AUTH__";

      proxy_http_version 1.1;
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host       $host;
      proxy_set_header X-Real-IP  $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
