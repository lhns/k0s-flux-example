# Component the XMPP clients talk to. Dial +49XXXXXXXXX@sip.xmpp.example.com; a caller comes back
# as +49XXXXXXXXX#<line>@sip.xmpp.example.com, which is also how to dial them. A label that names
# neither a line nor a SIP_TRUNKS host is REFUSED, so a foreign SIP address no longer dials.
COMPONENT_DOMAIN=sip.xmpp.example.com
# Asterisk's own component connection (chan_xmpp / xmpp.conf).
ASTERISK_COMPONENT_DOMAIN=asterisk.xmpp.example.com

# Prosody's external-component port. Not localhost: this runs in its own namespace,
# reachable only because apps/snikket/vnet.yaml allows it.
CONNECT_IP=snikket.snikket.svc.cluster.local
CONNECT_PORT=5347

# The PSTN trunk, and the one account the image's entrypoint registers by itself.
# SIP_PASSWORD comes from the Secret, not from here.
#
# SIP_HOST is not just "the trunk the entrypoint registers": the cheogram-sip binary is also
# given it as its PSTN gateway, and it appends that host to any number dialled without one.
# So SIP_HOST must be the trunk that carries outbound PSTN, or bare numbers can never reach
# it whatever the dialplan says. That is why PSTN is here and the other trunk is defined by
# hand in sip.conf, the reverse of how this started.
SIP_HOST=sip.example.net
SIP_USER=02012345678

# These three are ALSO declared in the routing chart's `registrations` table, as the entry
# marked `entrypoint: true` -- that is the only way this number has a line. Nothing renders a
# register line from it, but the three values must agree or every identity built from it is
# wrong; tests/check-routing.py holds them against each other.

# INBOUND only: the JID an incoming call rings. The entrypoint bakes it into the
# register line, so exactly one JID can be rung.
SIP_JID=admin@xmpp.example.com

# Our own trunk hosts. Each name MUST equal a peer name in sip.conf; sip.example.net is named by
# the image's entrypoint, which always calls its peer [$SIP_HOST]. These share the slot after
# "#" with LINE names, so no line may be called after one of them.
SIP_TRUNKS=sip.example.net,voip.example.org
# Which trunk carries a destination with NO host is no longer set here: that is the routing
# table's job now (routing/values.yaml, rendered into the cheogram-sip-routing ConfigMap).

# Caller-ID normalisation, applied by extensions.lua to inbound calls and SMS so one human
# is one JID and one Matrix portal room. +49..., 0049... and 0... all collapse to E.164;
# anything at or below SIP_SHORT_MAXLEN is left alone, so 110, 112 and eventpbx's own
# extensions survive. Empty SIP_E164_COUNTRY switches the whole thing off.
#
# SIP_SHORT_MAXLEN is ONLY this length guard now; it picks no trunk. Raising it stops
# numbers of that length being normalised, it does not move them between trunks.
SIP_SHORT_MAXLEN=5
SIP_E164_COUNTRY=49

# DELIBERATELY EMPTY, and empty is the safe value. A bare number is ambiguous: either a
# national number with the trunk 0 omitted, which needs only the country code, or a
# subscriber number whose area code is genuinely absent, which needs the area code
# prepended. Nothing in the call distinguishes them, and setting this turns 89123456 into
# +493089123456 unconditionally, corrupting every number of the first kind. It stays unset
# until a week of `normalize_e164:` NOTICE lines shows which the carrier actually sends.
SIP_E164_AREA=
