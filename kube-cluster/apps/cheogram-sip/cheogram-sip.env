# Component the XMPP clients talk to. Dial +49XXXXXXXXX@sip.xmpp.example.com; a caller comes back
# as +49XXXXXXXXX#<line>@sip.xmpp.example.com, which is also how to dial them. A label naming
# neither a line nor one of our trunk hosts is refused.
COMPONENT_DOMAIN=sip.xmpp.example.com
# Asterisk's own component connection (res_xmpp / xmpp.conf).
ASTERISK_COMPONENT_DOMAIN=asterisk.xmpp.example.com

# Prosody's external-component port. Not localhost: this runs in its own namespace,
# reachable only because apps/snikket/vnet.yaml allows it.
CONNECT_IP=snikket.snikket.svc.cluster.local
CONNECT_PORT=5347

# The PSTN trunk. The binary appends SIP_HOST to any number dialled without a host, and the
# dialplan strips it back off before routing. SIP_USER at SIP_HOST is the routing table's
# `entrypoint` registration; tests/check-routing.py holds them together.
SIP_HOST=sip.example.net
SIP_USER=02012345678

# Caller-ID normalisation for inbound calls and SMS, so one human is one JID and one Matrix
# portal room: +49..., 0049... and 0... collapse to E.164. Anything at or below
# SIP_SHORT_MAXLEN is left alone (110, 112, eventpbx extensions); it is only a length
# guard and picks no trunk. Empty SIP_E164_COUNTRY switches it off.
SIP_SHORT_MAXLEN=5
SIP_E164_COUNTRY=49

# Deliberately empty. A bare number is either a national one with the trunk 0 omitted or a
# subscriber number missing its area code, and nothing in the call says which. Setting this
# prepends the area code to both and corrupts the first kind. Leave it until the
# `normalize_e164:` NOTICE lines show which the carrier sends.
SIP_E164_AREA=
