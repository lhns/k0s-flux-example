{
  "uid": "webtop-desktops",
  "title": "Webtop Desktops",
  "tags": [
    "webtop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Provisioned from git (kube-cluster/apps/webtop). Needs the VictoriaMetrics datasource: MetricsQL, dotted metric names.",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "desktop",
        "label": "Desktop",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(webtop_desktop_info, desktop)",
          "refId": "q"
        },
        "definition": "label_values(webtop_desktop_info, desktop)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Desktops",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum(webtop_desktop_running) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
