  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ceph_health_status, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(ceph_health_status, cluster)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {}
      }
    ]
  },
