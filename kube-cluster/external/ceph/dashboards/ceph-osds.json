    },
    {
      "type": "link",
      "title": "Ceph pool",
      "icon": "dashboard",
      "url": "/d/ceph-pool/ceph-pool",
      "includeVars": true,
      "keepTime": true,
      "tooltip": "One pool",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Ceph CephFS",
      "icon": "dashboard",
      "url": "/d/ceph-cephfs/ceph-cephfs",
