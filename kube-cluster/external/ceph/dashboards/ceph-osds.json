    "ceph"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Ceph cluster",
      "icon": "dashboard",
      "url": "/d/ceph-cluster/ceph-cluster",
