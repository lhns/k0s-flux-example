      "tooltip": "Metadata servers",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Ceph RGW",
      "icon": "dashboard",
      "url": "/d/ceph-rgw/ceph-rgw",
      "includeVars": true,
      "keepTime": true,
      "tooltip": "S3 gateways",
      "targetBlank": false
