      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ceph_health_status, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(ceph_health_status, cluster)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {}
      },
      {
        "name": "osd",
        "label": "OSD",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ceph_osd_metadata{cluster=~\"$cluster|\"}, ceph_daemon)",
          "refId": "osd"
        },
        "definition": "label_values(ceph_osd_metadata{cluster=~\"$cluster|\"}, ceph_daemon)",
        "regex": "",
        "refresh": 2,
        "sort": 3,
