        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ceph_mds_inodes{cluster=~\"$cluster|\"}, ceph_daemon)",
          "refId": "mds_servers"
        },
        "definition": "label_values(ceph_mds_inodes{cluster=~\"$cluster|\"}, ceph_daemon)",
        "regex": "",
