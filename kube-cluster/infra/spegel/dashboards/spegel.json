{
  "uid": "spegel",
  "title": "Spegel",
  "description": "Spegel peer-to-peer image mirror: peer hits and misses, bytes served, resolve latency and what each node advertises (kube-cluster/infra/spegel).",
  "tags": [
    "spegel",
    "registry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "refresh": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Peer hit ratio per node",
      "description": "Share of mirror requests a peer answered (cache=hit) instead of falling back to the upstream registry. One spegel pod runs per worker, so the pod is the node.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(spegel_mirror_requests_total{cache=\"hit\"}[$__rate_interval])) / sum by (pod) (rate(spegel_mirror_requests_total[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peer hit vs miss per node",
      "description": "Mirror requests per second by outcome. A miss is pulled from upstream.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(spegel_mirror_requests_total{cache=\"hit\"}[$__rate_interval]))",
          "legendFormat": "hit {{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (rate(spegel_mirror_requests_total{cache=\"miss\"}[$__rate_interval]))",
          "legendFormat": "miss {{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peer hit vs miss per registry",
      "description": "Mirror requests per second by registry and outcome.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (registry) (rate(spegel_mirror_requests_total{cache=\"hit\"}[$__rate_interval]))",
          "legendFormat": "hit {{registry}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (registry) (rate(spegel_mirror_requests_total{cache=\"miss\"}[$__rate_interval]))",
          "legendFormat": "miss {{registry}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bytes served to peers per node",
      "description": "Response bytes of the registry endpoint (handler /v2/*, HTTP 200), per second.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(http_response_size_bytes_sum{handler=\"/v2/*\",code=\"200\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Resolve latency",
      "description": "Time to find a peer holding a blob (libp2p router), quantiles over all nodes.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(spegel_resolve_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spegel_resolve_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(spegel_resolve_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Age of last successful mirror",
      "description": "Seconds since the node last advertised successfully. It grows without bound when the router is stuck.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (pod) (spegel_mirror_last_success_timestamp_seconds)",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Advertised keys per node",
      "description": "Blobs and images each node announces to its peers.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (spegel_advertised_keys)",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
